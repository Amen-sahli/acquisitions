# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database Configuration
# Development (Neon Local via docker compose):
#   DATABASE_URL=postgres://neon:npg@neon-local:5432/neondb
# Production (Neon Cloud):
#   DATABASE_URL=postgresql://<user>:<password>@<hostname>.neon.tech/<database>?sslmode=require

# Neon Cloud credentials (only required by the Neon Local proxy in development)
# NEON_API_KEY=
# NEON_PROJECT_ID=

# Arcjet
# ARCJET_KEY=

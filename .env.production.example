# Server Configuration
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# Database Configuration - Neon Cloud (fully managed, serverless).
# Point this at your real Neon project branch: Project Settings -> Connection Details.
DATABASE_URL=postgresql://<user>:<password>@<hostname>.neon.tech/<database>?sslmode=require

# Arcjet
ARCJET_KEY=replace-with-your-arcjet-key

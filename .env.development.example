# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database Configuration - Neon Local (local proxy running inside Docker Compose)
DATABASE_URL=postgres://neon:npg@neon-local:5432/neondb

# Neon Cloud credentials - required by the Neon Local proxy (neon-local service)
# Create an API key: https://console.neon.tech/settings/api-keys
NEON_API_KEY=replace-with-your-neon-api-key
NEON_PROJECT_ID=replace-with-your-neon-project-id

# Optional: branch from a specific Neon branch.
# Leave commented out to use the project's default branch (recommended for dev).
# PARENT_BRANCH_ID=replace-with-your-parent-branch-id

# Arcjet
ARCJET_KEY=replace-with-your-arcjet-key
